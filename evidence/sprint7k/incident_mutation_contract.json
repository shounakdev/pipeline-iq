--- POST /api/incidents/{incident_id}/acknowledge ---
{
  "tags": [
    "Incidents"
  ],
  "summary": "Acknowledge Incident Endpoint",
  "description": "Acknowledge an incident.",
  "operationId": "acknowledge_incident_endpoint_api_incidents__incident_id__acknowledge_post",
  "security": [
    {
      "OAuth2PasswordBearer": []
    }
  ],
  "parameters": [
    {
      "name": "incident_id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid",
        "title": "Incident Id"
      }
    }
  ],
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/IncidentAcknowledgeRequest"
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "Successful Response",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/IncidentDetailResponse"
          }
        }
      }
    },
    "422": {
      "description": "Validation Error",
      "content": {
