{
  "uid": "payment-service",
  "title": "Payment Service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["platformiq", "payment-service", "runtime"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Payment Service Request Rate",
      "datasource": null,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"payment-service\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payment Service Error Rate",
      "datasource": null,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"payment-service\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx errors/sec"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": null,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p99",
      "datasource": null,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod Restarts",
      "datasource": null,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{pod=~\"payment-service.*\"}[15m]))",
          "legendFormat": "restarts"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Replicas Available",
      "datasource": null,
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment=\"payment-service\"}",
          "legendFormat": "available replicas"
        }
      ]
    }
  ]
}
