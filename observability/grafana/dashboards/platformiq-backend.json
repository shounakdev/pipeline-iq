{
  "uid": "platformiq-backend",
  "title": "PlatformIQ Backend",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["platformiq", "backend", "api"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate",
      "datasource": null,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (path, method) (rate(platformiq_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Latency p95",
      "datasource": null,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(platformiq_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Latency p99",
      "datasource": null,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, path) (rate(platformiq_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{path}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API Error Rate",
      "datasource": null,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(platformiq_http_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "API Status Codes",
      "datasource": null,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status_code) (increase(platformiq_http_requests_total[15m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pipeline Runs by Status",
      "datasource": null,
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status) (platformiq_pipeline_runs_total)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
